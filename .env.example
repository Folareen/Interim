# YouCam (server only, never exposed to the browser)
YOUCAM_API_KEY=
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
YOUCAM_MODE=replay # live | record | replay
YOUCAM_FIXTURES_DIR=../../packages/fixtures/youcam # relative to apps/api
PLANNER_FIXTURES_DIR=../../packages/fixtures/planner # recorded planner output, relative to apps/api
JUDGE_MODE_FORCE_REPLAY=true # wins over YOUCAM_MODE
LIVE_CALLS_ENABLED=false # no live YouCam call unless true

# Infra
DATABASE_URL=postgres://interim:interim@localhost:5432/interim
REDIS_URL=redis://localhost:6379

# Object storage: Cloudflare R2 (local and production). Create a private bucket and an
# Object Read & Write API token in the Cloudflare dashboard, and add a CORS rule that allows PUT from the web origin.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=interim
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# LLM (Gemini via Vercel AI SDK)
GOOGLE_GENERATIVE_AI_API_KEY=
LLM_MODEL=gemini-3.8-flash

# Unit budgets
UNIT_BUDGET_PER_RUN=50
UNIT_BUDGET_PER_PROFILE=500
UNIT_BUDGET_PER_DAY=2000
UNIT_BUDGET_PER_SOURCE_PER_DAY=100

# Sessions, uploads, bot check
SESSION_SECRET=change-me-to-a-random-string-of-32-characters-or-more
DATA_KEY= # 64 hex characters that encrypt saved reflections: openssl rand -hex 32. Back it up; without it they cannot be read
MAX_UPLOAD_BYTES=12582912
TURNSTILE_SECRET_KEY=

# Sign in. Mail: log prints emails and their links to the API console; brevo sends them (required in production).
WEB_ORIGIN=http://localhost:3000 # where the browser reaches the web app; emailed links and Google's return address start here
TRUST_PROXY_HOPS=1 # proxies in front of the API (the web server counts as one), so rate limits see the person's address
MAIL_MODE=log # log | brevo
BREVO_API_KEY=
MAIL_FROM_EMAIL= # a sender verified in Brevo
MAIL_FROM_NAME=Interim
# Optional Google sign in. Redirect address to register with Google: <WEB_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web push (optional). Notifications are off until both keys are set: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT= # a mailto: or https address push services can reach; defaults to WEB_ORIGIN

# API / web
PORT=4000
API_ORIGIN=http://localhost:4000 # the web server forwards /api/* here; never exposed to the browser
SUPPORT_EMAIL= # public contact on the privacy and terms pages; set before publishing
