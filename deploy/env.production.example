# Production settings for the VPS, saved as ~/interim/.env.production (mode 600). Never commit the real file.
NODE_ENV=production

# Postgres on Neon. Use the direct (not pooled) connection string, with sslmode=require and without channel_binding.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
# Interim's own Redis, started by PM2 on this machine.
REDIS_URL=redis://127.0.0.1:6380

# Cloudflare R2. Sharing a bucket with development is safe only with the prefix below: cleanup deletes what
# its own database does not know, and with a prefix it can only see its own files.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=interim
R2_REGION=auto
R2_KEY_PREFIX=prod/
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Replay only: judges can never spend units. The key stays empty on purpose, so a live call cannot happen even by mistake.
YOUCAM_API_KEY=
YOUCAM_MODE=replay
JUDGE_MODE_FORCE_REPLAY=true
LIVE_CALLS_ENABLED=false

# Generate fresh values: SESSION_SECRET with `openssl rand -hex 32`, DATA_KEY with `openssl rand -hex 32`.
SESSION_SECRET=
DATA_KEY=

# The address people type. With no domain, use a name that points at the IP, such as 203-0-113-7.sslip.io.
WEB_ORIGIN=https://HOST
# Caddy and the web server are two proxies in front of the API.
TRUST_PROXY_HOPS=2

# Production must send mail through Brevo.
MAIL_MODE=brevo
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Interim

# Interim's own ports (the server already runs other apps on 3000 and 4000).
PORT=4100
# The web server forwards /api here; it is on the same machine.
API_ORIGIN=http://127.0.0.1:4100
