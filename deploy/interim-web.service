[Unit]
Description=Interim web
After=network-online.target interim-api.service
Wants=network-online.target

[Service]
User=interim
WorkingDirectory=/opt/interim/apps/web
EnvironmentFile=/etc/interim/env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=3
MemoryMax=600M

[Install]
WantedBy=multi-user.target
